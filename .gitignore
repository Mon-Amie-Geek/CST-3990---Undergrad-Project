# -----------------------------------------------
# DATASETS — never pushed to GitHub
# stored on external drive only
# -----------------------------------------------
data/ua_detrac/raw/*
data/ua_detrac/processed/images/train/*
data/ua_detrac/processed/images/val/*
data/ua_detrac/processed/images/test/*
data/ua_detrac/processed/labels/train/*
data/ua_detrac/processed/labels/val/*
data/ua_detrac/processed/labels/test/*
data/ua_detrac/annotations/*
data/ai_city/*


# Keeping folder structure visible on GitHub
!data/ua_detrac/raw/.gitkeep
!data/ua_detrac/processed/images/train/.gitkeep
!data/ua_detrac/processed/images/val/.gitkeep
!data/ua_detrac/processed/images/test/.gitkeep
!data/ua_detrac/processed/labels/train/.gitkeep
!data/ua_detrac/processed/labels/val/.gitkeep
!data/ua_detrac/processed/labels/test/.gitkeep
!data/ua_detrac/annotations/.gitkeep
!data/ai_city/.gitkeep


# -----------------------------------------------
# MODEL WEIGHTS — too large for GitHub
# -----------------------------------------------
models/*
!models/.gitkeep
*.pt
*.pth
*.pkl
!models/minmax_scaler.pkl

# -----------------------------------------------
# CACHE, LOGS, RUNS — generated at runtime
# -----------------------------------------------
# Detector cache files kept for reproducibility
!detections_cache/
!detections_cache/train/
!detections_cache/val/
!detections_cache/test/
!detections_cache/train/yolov8n/
!detections_cache/val/yolov8n/
!detections_cache/test/yolov8n/
!detections_cache/train/ssd300/
!detections_cache/val/ssd300/
!detections_cache/test/ssd300/
!detections_cache/**/*.json
!detections_cache/README.json
!detections_cache/.gitkeep

!logs/.gitkeep
!logs/day3_frame_sync_results.json
!logs/warmup_frames_log.json
!logs/map_yolov8n_per_sequence.json

runs/*
!runs/.gitkeep

# -----------------------------------------------
# PYTHON ARTIFACTS
# -----------------------------------------------
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
venv/
.env

# -----------------------------------------------
# OS FILES
# -----------------------------------------------
.DS_Store
Thumbs.db